# R0 uses synthetic data only. Keep the development listener on localhost.
DATABASE_URL=sqlite:///./data/symsoil.db
SYMSOIL_MODE=development
SYMSOIL_COOKIE_SECURE=false
SYMSOIL_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Optional absolute path; otherwise the backend locates apps/web/dist.
# SYMSOIL_WEB_DIST=/absolute/path/apps/web/dist

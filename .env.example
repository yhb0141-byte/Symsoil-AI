# R0 uses synthetic data only. Keep the development listener on localhost.
DATABASE_URL=sqlite:///./data/symsoil.db
# Keep these as two independent persistent directories. They contain runtime
# identifiers and must never be committed. Defaults derive from DATABASE_URL.
# SYMSOIL_REVOCATION_DIR=/absolute/persistent/path/revocations
# SYMSOIL_RECOVERY_WITNESS_DIR=/another/persistent/path/witness
SYMSOIL_MODE=development
SYMSOIL_COOKIE_SECURE=false
SYMSOIL_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Optional absolute path; otherwise the backend locates apps/web/dist.
# SYMSOIL_WEB_DIST=/absolute/path/apps/web/dist
# Optional local expression suggestions. Disabled by default, no cloud fallback.
SYMSOIL_AI_ENABLED=false
# SYMSOIL_OLLAMA_MODEL=qwen3.5:9b
# SYMSOIL_OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_NO_CLOUD=1 belongs to the actual Ollama daemon, not only this app.
